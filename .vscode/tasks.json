{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate changed slides",
      "type": "process",
      "command": "python",
      "args": ["scripts/validate_changes.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Full deck regression",
      "type": "process",
      "command": "python",
      "args": ["scripts/validate_changes.py", "--full"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
